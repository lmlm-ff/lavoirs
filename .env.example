# Local API
API_PORT=3002
DEV_FAKE_USER_AUTH=true

# Local LiveKit. For LiveKit Cloud, use the project's WSS URL and credentials.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: when configured, sessions generate icebreakers with this model.
# Without a key, the server uses the generator's interest-based fallback prompt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase values for the future persistent auth/profile/matching adapter.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
