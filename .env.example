# Local option: run `npm run dev:livekit` in a terminal first.
API_PORT=3002
# LiveKit's local dev server uses this key/secret pair.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For LiveKit Cloud instead, replace the three values above with that project's
# WSS URL, API key, and API secret. Never put the API secret in browser code.

# Enables the seeded fake identities only for local development.
DEV_FAKE_USER_AUTH=true
